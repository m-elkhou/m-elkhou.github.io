# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{html,htm}]
indent_size = 2
max_line_length = 120

[*.{css,scss,sass}]
indent_size = 2
max_line_length = 120

[*.{js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 120
quote_type = single

[*.{json,jsonc}]
indent_size = 2
max_line_length = 120

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 80

[*.{yml,yaml}]
indent_size = 2
max_line_length = 120

[Makefile]
indent_style = tab
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.py]
indent_size = 4
max_line_length = 88

[*.{php,phtml}]
indent_size = 4
max_line_length = 120